# Use the pooled Neon URL at runtime; include sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=3"
# A direct (non-pooler) URL for prisma migrate deploy, if available.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
# ADMIN_EMAIL / ADMIN_PASSWORD are only needed locally for npm run db:init.
# Do not store production bootstrap credentials in GitHub or Vercel.
